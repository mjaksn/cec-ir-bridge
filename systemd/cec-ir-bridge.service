[Unit]
Description=HDMI-CEC volume, mute and power bridge to an ESP32 IR blaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cec-ir-bridge
Restart=always
RestartSec=5
# Journal gets stdout/stderr; view with: journalctl -u cec-ir-bridge -f

[Install]
WantedBy=multi-user.target
